{
  "netsec-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/secret-guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
